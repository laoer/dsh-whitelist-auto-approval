{
  "name": "dsh-whitelist-auto-approval",
  "version": "0.4.0",
  "description": "Per-command sandbox allow-list for the DSH bash tool, managed from Settings and the Plugins page: allow-listed CLIs run with configurable writable roots (workspace stays writable on macOS/Linux) instead of prompting for danger-full-access; write-neutral pipes such as `2>&1 | tail -N` still match, and a narrow-root rule can accept any command shape.",
  "license": "MIT",
  "author": "Tim Gong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laoer/dsh-whitelist-auto-approval.git"
  },
  "homepage": "https://github.com/laoer/dsh-whitelist-auto-approval#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "sandbox",
    "approval",
    "whitelist",
    "allowlist",
    "bash",
    "settings",
    "web-ui"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "matcher.js",
    "overlay.js",
    "schema.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/**"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
